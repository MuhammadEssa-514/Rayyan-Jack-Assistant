# =============================================
# Jack AI Server - Environment Configuration
# =============================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB - Local (default)
MONGODB_URI=mongodb://localhost:27017/jackai

# MongoDB Atlas (uncomment to use cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/jackai

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# CORS - Dashboard URL
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Security
JWT_SECRET=change_this_to_random_secret_key_minimum_32_chars

# Voice Engine WebSocket (Python connects here)
VOICE_ENGINE_PORT=5001
